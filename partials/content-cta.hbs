{{{html}}}
<aside class="gh-post-upgrade-cta">
    <div class="gh-post-upgrade-cta-content" style="background-color: {{@site.accent_color}}">
        {{#has visibility="paid"}}
            {{#is "page"}}
                <h2>{{t "{thisPostOrPage} is for paying subscribers only" thisPostOrPage=(t "This page")}}</h2>
            {{else}}
                <h2>{{t "{thisPostOrPage} is for paying subscribers only" thisPostOrPage=(t "This post")}}</h2>
            {{/is}}
        {{/has}}
        {{#has visibility="members"}}
            {{#is "page"}}
                <h2>{{t "{thisPostOrPage} is for subscribers only" thisPostOrPage=(t "This page")}}</h2>
            {{else}}
                <h2>{{t "{thisPostOrPage} is for subscribers only" thisPostOrPage=(t "This post")}}</h2>
            {{/is}}
        {{/has}}
        {{#has visibility="tiers"}}
            {{#is "page"}}
                <h2>{{t "{thisPostOrPage} is for subscribers on the following tiers only:" thisPostOrPage=(t "This page")}}{{tiers suffix=""}}</h2>
            {{else}}
                <h2>{{t "{thisPostOrPage} is for subscribers on the following tiers only:" thisPostOrPage=(t "This post")}}{{tiers suffix=""}}</h2>
            {{/is}}
        {{/has}}
        {{#if @member}}
            <a class="gh-btn" data-portal="account/plans" href="#/portal/account/plans" style="color:{{@site.accent_color}}">{{t "Upgrade your account"}}</a>
        {{else}}
            <a class="gh-btn" data-portal="signup" href="#/portal/signup" style="color:{{@site.accent_color}}">{{t "Subscribe now"}}</a>
            <p><small>{{t "Already have an account?"}} <a data-portal="signin" href="#/portal/signin">{{t "Sign in"}}</a></small></p>
        {{/if}}
    </div>
</aside>